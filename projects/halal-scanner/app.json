{
  "expo": {
    "name": "HalalCheck",
    "slug": "halalcheck",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "halalcheck",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1A0F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.halalcheck.app"
    },
    "android": {
      "package": "fr.halalcheck.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "HalalCheck utilise la caméra uniquement pour scanner les codes-barres des produits."
        }
      ]
    ]
  }
}
