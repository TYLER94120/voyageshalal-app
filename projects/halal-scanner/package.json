    "sonde:photo": "node scripts/sonde-photo.mjs",
    "sonde:fiches": "node scripts/sonde-fiches-reelles.mjs",
    "sonde:iphone": "node scripts/sonde-iphone.mjs",
    "sonde:saisie": "node scripts/sonde-saisie.mjs",
    "sonde:pays": "node scripts/sonde-pays.mjs",
    "sonde:inci": "node scripts/sonde-inci.mjs",
    "sonde:verdicts": "node scripts/sonde-verdicts.mjs",
