{
  "expo": {
    "name": "VoyagesHalal",
    "slug": "voyageshalal-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voyageshalal",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dad12ec8-c7bb-4df5-bf06-bafbc35f48a4"
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voyageshalal.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0b1a0f"
      },
      "package": "com.voyageshalal.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCwXaJN9tNpB0P9-hjGOa_VvMIrO0DdeKs"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VoyagesHalal utilise votre position pour afficher les mosquées, restaurants halal et hôtels près de vous.",
          "locationAlwaysAndWhenInUsePermission": "VoyagesHalal utilise votre position pour afficher les lieux halal près de vous."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0b1a0f"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0b1a0f",
          "sounds": ["./assets/sounds/adhan.mp3"]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PrayerWidget",
              "label": "Horaires de prière",
              "description": "Les 5 prières du jour, toujours visibles",
              "minWidth": "250dp",
              "minHeight": "80dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "voyageshalal1",
    "extra": {
      "eas": {
        "projectId": "dad12ec8-c7bb-4df5-bf06-bafbc35f48a4"
      }
    }
  }
}
